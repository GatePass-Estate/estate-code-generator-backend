# =======================================================================
# GatePass — Environment Variables Reference
#
# Copy the relevant sections into the appropriate .env.secrets files.
# NEVER commit actual secret values.
#
# Load order per service (docker-compose):
#   1. .env.secrets          ← root, shared across all services
#   2. services/<svc>/.env.secrets   ← service-specific secrets
#   3. services/<svc>/.env.localdocker ← non-secret local overrides
# =======================================================================


# -----------------------------------------------------------------------
# ROOT (.env.secrets) — shared across all services
# -----------------------------------------------------------------------

# JWT / session signing key — must be identical across every service
SECRET_KEY=

# Shared internal API key for service-to-service auth (X-Internal-Key)
INTERNAL_API_KEY=

# Internal Docker-network base URLs
DB_SERVICE_URL=http://db-service:9032/
NOTIFICATION_SERVICE_URL=http://notification-service:9035/

# Public frontend base URL — used in email CTAs
FRONTEND_BASE_URL=https://app.gatepassng.com


# -----------------------------------------------------------------------
# CACHE SERVICE (services/cache_service/.env.secrets)
# -----------------------------------------------------------------------

REDIS_HOST=estate_code_redis
REDIS_PORT=6379


# -----------------------------------------------------------------------
# DB SERVICE (services/db-service/.env.secrets)
# -----------------------------------------------------------------------

DB_HOST=estate_code_postgres
DB_PORT=5432
GOOGLE_APPLICATION_CREDENTIALS=
GCS_DOCUMENTS_BUCKET=gatepass-user-documents
GCS_SIGNED_URL_EXPIRY_SECONDS=300


# -----------------------------------------------------------------------
# CODE SERVICE (services/code_service/.env.secrets)
# -----------------------------------------------------------------------

CACHE_SERVICE_URL=http://cache-service:9031/
RESIDENT_CODE_EXPIRY_DAYS=30


# -----------------------------------------------------------------------
# USER PROFILE SERVICE (services/user_profile_service/.env.secrets)
# -----------------------------------------------------------------------


LOGIN_EXPIRE_MINUTES=60
TOS_VERSION=1.0.0

# Fernet key for encrypting TOTP seeds at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Days before a 2FA-verified IP is no longer considered "familiar"
TWO_FA_FAMILIAR_IP_DAYS=30
# Days before 2FA is forced again regardless of IP familiarity
TWO_FA_FORCE_REAUTH_DAYS=60


# -----------------------------------------------------------------------
# AI SERVICE (services/ai_service/.env.secrets)
# -----------------------------------------------------------------------

USER_PROFILE_SERVICE_URL=http://user-profile-service:9034/
CODE_SERVICE_URL=http://code-service:9033/

# Optional — only needed for LLM-powered incident summaries
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com


# -----------------------------------------------------------------------
# NOTIFICATION SERVICE (services/notification_service/.env.secrets)
# -----------------------------------------------------------------------

NOTIFICATION_MAX_AGE_DAYS=90
NOTIFICATION_PURGE_MIN_AGE_DAYS=90

# Firebase Cloud Messaging — full service account JSON as a single line
FCM_CREDENTIALS_JSON=

# Email / SMTP
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=GatePass
MAIL_SERVER=
MAIL_PORT=587
MAIL_SSL_TLS=false
MAIL_STARTTLS=true

# Set to false to actually send emails (default: true suppresses sends)
MAIL_DEV_MODE=true
